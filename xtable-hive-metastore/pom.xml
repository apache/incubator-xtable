                                    <include>org.ehcache:ehcache</include>
                                    <include>org.fusesource.leveldbjni:leveldbjni-all</include>
                                    <include>org.scala-lang:scala-library</include>
                                    <include>stax:stax-api</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
